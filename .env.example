# --- IA de texto (generación de contenido) ---
# Con las dos cargadas, ai_providers.py alterna entre ellas y si una se queda
# sin cuota (pasa seguido con el free tier de Groq) cae a la otra sola. Con
# una sola cargada, el bot funciona igual, solo que sin ese respaldo.
#
# Groq: free tier sin tarjeta -> https://console.groq.com
GROQ_API_KEY=tu-api-key-de-groq-aqui
# GROQ_MODEL=openai/gpt-oss-120b   # opcional, este es el default
#
# Gemini: free tier sin tarjeta -> https://aistudio.google.com/apikey
GEMINI_API_KEY=tu-api-key-de-gemini-aqui
# GEMINI_MODEL=gemini-3.6-flash   # opcional, este es el default

# --- IA de imágenes (slides 'foto', íconos pixel art y fondos del formato impacto) ---
# Cloudflare Workers AI (FLUX.1-schnell): el proveedor bueno. Gratis y sin
# tarjeta — 10.000 neurons por día, unas 400 imágenes al tamaño que usa el bot.
# Hacen falta los DOS valores; con uno solo se ignora y se usa Pollinations.
#  1. Creá una cuenta gratis en https://dash.cloudflare.com/sign-up
#  2. Account ID: está en la home del dashboard, o en la URL cuando entrás a
#     tu cuenta (dash.cloudflare.com/<ESTE-ES-EL-ACCOUNT-ID>)
#  3. Token: Mi perfil -> API Tokens -> Create Token -> plantilla "Workers AI"
#     (permiso Account / Workers AI / Read). Se muestra UNA sola vez.
CLOUDFLARE_ACCOUNT_ID=tu-account-id-de-cloudflare-aqui
CLOUDFLARE_API_TOKEN=tu-api-token-de-cloudflare-aqui
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell   # opcional, es el default
#
# Pollinations.ai queda como red de seguridad: gratis, sin API key y sin cuenta,
# no hace falta configurar nada. Se usa solo si Cloudflare no está configurado,
# se quedó sin cuota o se cayó. Su modelo anónimo (SANA) es más flojo que FLUX.

# --- Formato 'video narrado' (voz + b-roll, alternativa al carrusel) ---
# Pexels: b-roll de video real. Gratis, aprobación instantánea.
# -> https://www.pexels.com/api/ (loguéate y ahí generás la key, el link no es la key)
PEXELS_API_KEY=tu-api-key-de-pexels-aqui
#
# ElevenLabs: locución. Free tier (~10.000 caracteres/mes), sin tarjeta.
# -> https://elevenlabs.io/app/settings/api-keys
# OJO: el free tier NO deja usar voces de la Voice Library completa vía API
# (tira 402 "paid_plan_required") — solo las premade que ya vienen en tu
# cuenta. GET https://api.elevenlabs.io/v1/voices con tu key lista cuáles.
ELEVENLABS_API_KEY=tu-api-key-de-elevenlabs-aqui
# ELEVENLABS_VOICE_ID=TX3LPaxmHKxFdv7VOQHJ   # opcional, default: voz premade "Liam"

# --- Investigación de competencia (opcional, no forma parte de /generar) ---
# ScrapeCreators: de PAGO por request, no tiene free tier sostenible.
# -> https://scrapecreators.com
SCRAPECREATORS_API_KEY=tu-api-key-de-scrapecreators-aqui

# --- Telegram (aprobación manual antes de publicar) ---
# Bot token: hablale a @BotFather en Telegram, /newbot, y copiá el token que te da.
TELEGRAM_BOT_TOKEN=tu-token-de-botfather-aqui
# Chat id: mandale un mensaje cualquiera a tu bot y después visitá
# https://api.telegram.org/bot<TOKEN>/getUpdates para ver tu "chat":{"id": ...}
TELEGRAM_CHAT_ID=tu-chat-id-aqui

# --- TikTok (Content Posting API) ---
# Creá una app en https://developers.tiktok.com/apps, agregá el producto
# "Content Posting API" y pedí el scope video.publish.
TIKTOK_CLIENT_KEY=tu-client-key-aqui
TIKTOK_CLIENT_SECRET=tu-client-secret-aqui
# Registrá este mismo redirect URI en la config de la app (Desktop app, puerto *)
TIKTOK_REDIRECT_URI=http://127.0.0.1:8921/callback/

# --- Instagram (Graph API, opcional) ---
# Solo hace falta si vas a publicar en Instagram desde el wizard de /generar
# (formato o video). Sin esto el bot funciona igual, solo para TikTok.
#
# Requisitos previos:
#  1. La cuenta de Instagram tiene que ser Business o Creator, vinculada a
#     una Página de Facebook (Instagram → Configuración → Cuentas vinculadas
#     → Facebook).
#  2. Creá una app en https://developers.facebook.com/apps (tipo "Business"),
#     agregale el producto "Instagram Graph API".
#  3. Copiá el App ID y el App Secret (Configuración → Básica) acá abajo.
#  4. Corré 'python instagram_auth.py' una vez (te va a pedir pegar un token
#     corto sacado del Graph API Explorer) — guarda la sesión en
#     ig_tokens.json, que NO se commitea.
META_APP_ID=tu-app-id-de-meta-aqui
META_APP_SECRET=tu-app-secret-de-meta-aqui
# META_GRAPH_API_VERSION=v26.0   # opcional, este es el default; subilo si Meta lo deprecó
